<UserControl x:Class="Aerochat.Controls.AdImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aerochat.Controls"
             xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
             mc:Ignorable="d" MinWidth="60" Height="60">
    <ContentControl Content="{Binding}">
        <ContentControl.Style>
            <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate><Image Stretch="Fill" Source="{Binding ImageUri}" /></DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ImageType}" Value="Gif">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate><Image Stretch="Fill" gif:AnimationBehavior.SourceUri="{Binding ImageUri}" /></DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ImageType}" Value="SpritesheetAnimation">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <local:AnimatedTileImage Image="{Binding ImageUri}" FrameDirection="Vertical" FrameDuration="{Binding AnimationFramerate}" NumberOfFrames="{Binding AnimationFrames}" Width="234" Height="60" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ContentControl.Style>
    </ContentControl>
</UserControl>
